# Environment variables required by the application
# Copy this file to .env and fill in the values.

# Application Configuration
NODE_ENV=development # development | production | test
PORT=3001

# Database (PostgreSQL)
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"
# For explicit connection parameters, uncomment the following lines and fill in the values
# PG_HOST="HOST"
# PG_PORT="PORT"
# PG_USER="Username"
# PG_PASSWORD="PASSWORD"
# PG_DATABASE="DATABASE"

# API Configuration
CORS_ORIGIN="*" # Or specify your frontend URL, e.g., http://localhost:5173

# Allowed frontend host address (for security middleware)
# Example: HOST_ADDRESS=mailvoyage.in
HOST_ADDRESS=localhost:5173 # Default for Vite dev server

# Extra host names the API may serve (comma-separated, no ports) — set this
# when deploying to Render/Railway/Fly/AWS/Azure/GCP or any custom domain,
# e.g. ALLOWED_HOSTS=mailvoyage.onrender.com,api.mailvoyage.com
# Render injects RENDER_EXTERNAL_HOSTNAME automatically; Vercel VERCEL_URL too.
# ALLOWED_HOSTS=""

PWD_SECRET="YOUR_STRONG" # Secret key for password encryption/decryption

# Security
JWT_SECRET="YOUR_VERY_SECURE_JWT_SECRET"
JWT_EXPIRES_IN="1h" # e.g., 1h, 1d, 7d
JWT_COOKIE_EXPIRES_IN="36000000" # Cookie expiry in milliseconds (example: 10 hours)

# Optional feature if implemented should modify the file: token.service.ts and auth.service.ts in services folder
# Optional: Refresh Tokens (if implemented)
# JWT_REFRESH_SECRET="YOUR_VERY_SECURE_JWT_REFRESH_SECRET_DIFFERENT_FROM_ACCESS_SECRET"
# JWT_REFRESH_EXPIRES_IN="7d"

# Optional: JWT Algorithm (if using asymmetric encryption)
#
# JWT Algorithm (HS256 is recommended for most cases but can be changed)
# Example: JWT_ALGORITHM="RS256"
# Note: If you change the algorithm, ensure that the public/private keys are set up correctly.
# Example: JWT_PUBLIC_KEY="your_public_key"
# Example: JWT_PRIVATE_KEY="your_private_key"
# Example: JWT_KEY_PATH="/path/to/your/private/key.pem"
# Example: JWT_PUBLIC_KEY_PATH="/path/to/your/public/key.pem"
# You can use or remove JWT_ALGORITHM, JWT_PUBLIC_KEY, JWT_PRIVATE_KEY, JWT_KEY_PATH, and JWT_PUBLIC_KEY_PATH as per your needs.
# JWT_ALGORITHM="HS256"

# Optional: Logging Configuration
# LOG_LEVEL="info" # error | warn | info | http | verbose | debug | silly

# SMTP Configuration for Email Services (Required for OTP and password reset)
# SMTP server configuration for sending emails
SMTP_HOST="smtp.gmail.com" # Gmail SMTP server (change for other providers)
SMTP_PORT="587" # Standard port for TLS (use 465 for SSL)
SMTP_SECURE="false" # Set to true for SSL (port 465), false for TLS (port 587)
SMTP_USER="your-email-address" # Your username or email address
SMTP_PASS="your-app-password" # Your email password or app-specific password
SMTP_FROM_NAME="MailVoyage" # Sender name displayed in emails
SMTP_FROM_EMAIL="noreply@mailvoyage.com" # Sender email address

# Two-factor authentication
# Strong secret used to derive encryption key for stored TOTP secrets.
# If omitted, the server derives a fallback from JWT_SECRET.
# The TOTP entries are optional a fallback derived keys and defaults are set in config.ts, but it is highly recommended to set a strong random value for TOTP_ENCRYPTION_KEY in production.
# TOTP_ENCRYPTION_KEY="SET_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS"
# TWO_FACTOR_ISSUER="MailVoyage"
# TWO_FACTOR_LOGIN_TOKEN_TTL_SEC="300"
# TWO_FACTOR_SETUP_TOKEN_TTL_SEC="600"
# TWO_FACTOR_OTP_TOKEN_TTL_SEC="600"
# TWO_FACTOR_OTP_RESEND_INTERVAL_SEC="30"
# TWO_FACTOR_RECOVERY_CODE_COUNT="10"

# Auth attempt rate-limiting (persisted in DB)
# AUTH_RATE_LIMIT_WINDOW_SEC="900"
# AUTH_RATE_LIMIT_MAX_ATTEMPTS="5"
# AUTH_RATE_LIMIT_LOCK_SEC="300"

# ── Scalability tunables ────────────────────────────────────────────────────
# Raise these for larger deployments (many concurrent users). Defaults are
# sized for small/medium single-instance deployments.

# PostgreSQL pool ceiling (default 20). Each poller worker or API request
# holds a pool client while working; raise if you see connection waits.
# DB_POOL_MAX="20"
# DB_POOL_IDLE_TIMEOUT_MS="30000"

# Background mail poller: how often connected users' mailboxes are checked
# (default every 120s) and how many users are checked per cycle (default 25).
# The poller rotates fairly across ALL connected users every cycle, so with
# N users and M per cycle everyone is checked within ceil(N/M) cycles.
# POLL_INTERVAL_SEC="120"
# POLL_MAX_USERS_PER_CYCLE="25"
# Per-account mail-server check timeout in seconds (default 15).
# POLL_ACCOUNT_TIMEOUT_SEC="15"
# Debounce for login/reconnect-triggered immediate polls in seconds
# (default 20) — protects against reconnect storms opening many
# mail-server connections at once.
# POLL_IMMEDIATE_DEBOUNCE_SEC="20"

# ── Feature switches (graceful degradation) ─────────────────────────────────
# ENABLE_WEBSOCKET="true"   # Set false on serverless platforms (Vercel etc.)
#   → clients fall back to manual Sync button + REST flag updates.
# ENABLE_MAIL_POLLER="true" # Set false on free tiers with strict CPU/duration
#   budgets → users fetch new mail on demand via the Sync button.

# Optional: Vercel System Environment Variables (usually set automatically)
# VERCEL_URL=""
